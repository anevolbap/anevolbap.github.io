\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-silver}[2026/06/23 silver-dev-cv look-alike for org export]

% --- engine / font (lualatex + fontspec) ---
\RequirePackage{fontspec}
\setmainfont{TeX Gyre Pagella}
% microtype: better justification, fewer overfull lines
\RequirePackage{microtype}

% --- page geometry ---
\RequirePackage[a4paper,top=1.2cm,bottom=1.15cm,left=1.65cm,right=1.65cm]{geometry}

% --- colours / links ---
\RequirePackage{xcolor}
\definecolor{linkblue}{RGB}{0,0,238}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,urlcolor=linkblue,linkcolor=linkblue,citecolor=linkblue}

% --- lists (tight bullets) ---
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.3em,itemsep=2pt,topsep=2pt,parsep=0pt,partopsep=0pt,label=\textbullet}

% --- footer: last updated (L), name (C), page n/total (R) ---
\RequirePackage{lastpage}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\itshape Last updated: \cvdate}
\fancyfoot[C]{\footnotesize \cvname}
\fancyfoot[R]{\footnotesize \thepage\,/\,\pageref{LastPage}}

% --- layout defaults ---
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% --- semantic macros (mirror the typst template) ---

% \cvheader{name}{address}{email}
\newcommand{\cvheader}[4]{%
  \begin{center}
    {\LARGE\bfseries #1}\\[3pt]
    {\normalsize #2}\\[1pt]
    {\small\href{mailto:#3}{#3}%
      \if\relax\detokenize{#4}\relax\else
        \ \textbullet\ \href{https://#4}{#4}%
      \fi}
  \end{center}
  \vspace{2pt}%
}

% \cvsection{title}
\newcommand{\cvsection}[1]{%
  \par\vspace{5pt}%
  {\large\bfseries\MakeUppercase{#1}}\par
  \vspace{2pt}%
  {\color{black}\hrule height 0.5pt}%
  \vspace{4pt}%
}

% \cvjob{position}{institution}{location}{date}{bullets}
\newcommand{\cvjob}[5]{%
  \par\vspace{4pt}%
  \noindent\textbf{#1}\hfill\textit{#3}\par
  \noindent\textit{#2}\hfill\textit{#4}\par
  \vspace{2pt}%
  #5%
  \par\vspace{3pt}%
}

% \cvskill{title}{content}
\newcommand{\cvskill}[2]{\noindent\textbf{#1:} #2\par}

% \cveducation{institution}{major}{date}{location}
\newcommand{\cveducation}[4]{%
  \par\vspace{2pt}%
  \noindent\textbf{#1}\hfill\textit{#3}\par
  \noindent\textit{#2}\par
}

% \cvdescript{text}
\newcommand{\cvdescript}[1]{\noindent #1\par}

% \sectionsep
\newcommand{\sectionsep}{\vspace{4pt}}

\endinput
